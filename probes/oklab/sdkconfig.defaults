# Oklab kernel probe. Target esp32s3 at 240 MHz. The console is UART0 with the USB serial JTAG port
# as the secondary console (the esp32s3 default), so the output reaches QEMU and the badge's USB
# port both.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y
